---
import type { CollectionEntry } from 'astro:content';
import SectionHead from '../SectionHead.astro';
import { resolveHref } from '../../lib/i18n';

interface Props {
  data: CollectionEntry<'site'>['data'];
  id: string;
  index: number;
  total: number;
}

const { data, id, index, total } = Astro.props;
const { lbn } = data;
---

<section id={id} class="scroll-mt-20 border-b border-line" aria-labelledby={`${id}-title`}>
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <SectionHead index={index} total={total} title={lbn.title} intro={lbn.text} id={id} />

    <div class="grid gap-10 md:grid-cols-12 md:gap-8">
      <ol class="grid gap-4 md:col-span-8 md:grid-cols-3" role="list">
        {
          lbn.activities.map((a, i) => (
            <li class="card p-6" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
              <span class="label">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="display mt-4 text-xl !tracking-[-0.02em]">{a.title}</h3>
              <p class="mt-2 text-muted">{a.detail}</p>
            </li>
          ))
        }
      </ol>

      <div class="self-start border-t border-line pt-6 md:col-span-4" data-reveal style="--reveal-delay: 160ms">
        <dl class="grid grid-cols-3 gap-4 md:grid-cols-1">
          {
            lbn.facts.map((f) => (
              <div class="flex flex-col gap-1 md:flex-row md:items-baseline md:justify-between">
                <dt class="label">{f.label}</dt>
                <dd class="font-mono text-sm">{f.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-6">
          <a href={resolveHref(lbn.legal.href)} class="font-mono text-sm text-accent underline-offset-4 hover:underline" data-umami-event="legal-click" data-umami-event-location="lbn">
            {lbn.legal.label} →
          </a>
        </p>
      </div>
    </div>
  </div>
</section>
