---
import type { CollectionEntry } from 'astro:content';
import Icon from '../Icon.astro';

interface Props {
  data: CollectionEntry<'site'>['data'];
  id: string;
  index: number;
  total: number;
}

const { data, id, index, total } = Astro.props;
const { contact, a11y } = data;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id={id} class="grid-bg scroll-mt-20" aria-labelledby={`${id}-title`}>
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-36">
    <p class="label" data-reveal>§ {pad(index)} <span class="text-line-strong">/ {pad(total)}</span></p>
    <h2 id={`${id}-title`} class="display mt-4 text-[2.25rem] md:text-[3rem]" data-reveal>{contact.title}</h2>
    <p class="display mt-8 max-w-[24ch] text-[clamp(1.75rem,4.5vw,3.5rem)] !font-medium !leading-[1.08] !tracking-[-0.025em]" data-reveal style="--reveal-delay: 80ms">
      {contact.text}
    </p>
    <div class="mt-10 flex flex-col gap-6 sm:flex-row sm:items-center" data-reveal style="--reveal-delay: 160ms">
      <a href={contact.cta.href} class="btn btn-primary !min-h-14 !px-7 !text-base" target="_blank" rel="noopener noreferrer me">
        <Icon name="linkedin" class="!h-5 !w-5" />
        {contact.cta.label}
        <Icon name="arrow-up-right" />
        <span class="sr-only"> {a11y.externalLink}</span>
      </a>
      <p class="max-w-sm font-mono text-xs leading-relaxed text-muted">{contact.aside}</p>
    </div>
  </div>
</section>
