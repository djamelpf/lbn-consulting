---
import type { CollectionEntry } from 'astro:content';
import Icon from '../Icon.astro';
import Portrait from '../Portrait.astro';

interface Props {
  data: CollectionEntry<'site'>['data'];
}

const { data } = Astro.props;
const { hero, a11y } = data;
const isExternal = (href: string) => /^https?:/.test(href);
---

<section class="hero grid-bg relative overflow-hidden border-b border-line" data-halo aria-labelledby="hero-title">
  <div class="halo pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-7xl gap-12 px-4 pb-16 pt-14 sm:px-6 md:pt-20 lg:grid-cols-12 lg:gap-8 lg:px-8 lg:pb-24 lg:pt-24">
    <div class="lg:col-span-7">
      <h1 id="hero-title">
        <span class="label hero-in hero-eyebrow block" style="--in: 0">{hero.eyebrow}</span>
        <span class="display hero-in mt-5 block text-[clamp(2.75rem,9vw,6.5rem)]" style="--in: 1">
          {hero.name}
        </span>
      </h1>

      <p class="display hero-in mt-6 max-w-[22ch] text-[clamp(1.5rem,3.2vw,2.5rem)] !font-medium !leading-[1.1] !tracking-[-0.02em]" style="--in: 2">
        {hero.hook}
      </p>

      <p class="hero-in prose-site mt-5 text-lg leading-relaxed text-muted md:text-xl" style="--in: 3">
        {
          hero.symptoms.map((s, i) => (
            <Fragment>
              <span class="symptom text-fg" style={`--i: ${i}`}>{s}</span>{i < hero.symptoms.length - 1 ? ', ' : ' : '}
            </Fragment>
          ))
        }
        {hero.promise}
      </p>

      <div class="hero-in mt-9 flex flex-wrap gap-3" style="--in: 4">
        <a
          href={hero.ctaPrimary.href}
          class="btn btn-primary"
          data-umami-event="cta-linkedin"
          data-umami-event-location="hero"
          target={isExternal(hero.ctaPrimary.href) ? '_blank' : undefined}
          rel={isExternal(hero.ctaPrimary.href) ? 'noopener noreferrer me' : undefined}
        >
          <Icon name="linkedin" />
          {hero.ctaPrimary.label}
          {isExternal(hero.ctaPrimary.href) && <span class="sr-only"> {a11y.externalLink}</span>}
        </a>
        <a
          href={hero.ctaSecondary.href}
          class="btn btn-ghost"
          data-umami-event="cta-calendly"
          data-umami-event-location="hero"
          target={isExternal(hero.ctaSecondary.href) ? '_blank' : undefined}
          rel={isExternal(hero.ctaSecondary.href) ? 'noopener noreferrer' : undefined}
        >
          <Icon name="calendar" />
          {hero.ctaSecondary.label}
          {isExternal(hero.ctaSecondary.href) && <span class="sr-only"> {a11y.externalLink}</span>}
        </a>
      </div>

      <dl class="hero-in mt-12 grid grid-cols-1 gap-x-8 gap-y-4 border-t border-line pt-6 sm:grid-cols-3" style="--in: 5">
        {
          hero.meta.map((m) => (
            <div>
              <dt class="label">{m.label}</dt>
              <dd class="mt-1 font-mono text-sm text-fg">{m.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="hero-in lg:col-span-5 lg:col-start-8" style="--in: 2">
      <Portrait variant="hero" alt={a11y.portraitAlt} caption={`FIG. 01 — ${hero.name}, Lille`} class="mx-auto max-w-md lg:ml-auto lg:max-w-none" />
    </div>
  </div>

  <a href={`#${data.nav.items[0]?.id ?? ''}`} class="label absolute bottom-5 right-5 hidden items-center gap-2 hover:text-accent lg:inline-flex">
    {hero.scrollHint}
    <Icon name="arrow-down" class="h-4 w-4 motion-safe:animate-bounce" />
  </a>
</section>

<style>
  .hero-in {
    animation: hero-in 700ms var(--ease-out) both;
    animation-delay: calc(var(--in, 0) * 90ms);
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Decorative section number, kept out of the H1 text content. */
  .hero-eyebrow::before {
    content: "§ 00 — ";
    color: var(--accent);
  }

  .halo {
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
    background: radial-gradient(
      18rem 18rem at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--accent) 16%, transparent),
      transparent 70%
    );
  }

  .hero.halo-on .halo {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-in {
      animation: none;
    }
    .halo {
      display: none;
    }
  }
</style>
