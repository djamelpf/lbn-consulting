---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/i18n';
import { homePath } from '../lib/i18n';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';

interface Props {
  locale: Locale;
  data: CollectionEntry<'site'>['data'];
  kind: 'home' | 'legal';
}

const { locale, data, kind } = Astro.props;
const home = homePath(locale);
const pad = (n: number) => String(n).padStart(2, '0');
// On the legal page, section links point back to the home page anchors.
const anchor = (id: string) => (kind === 'home' ? `#${id}` : `${home}#${id}`);
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6 lg:px-8">
    <a href={home} class="display flex items-baseline gap-2 text-base tracking-tight">
      <span>Djamel Labani</span>
      <span class="label hidden text-accent sm:inline" aria-hidden="true">§</span>
    </a>

    <nav aria-label={data.a11y.mainNav} class="ml-auto hidden xl:block" id="site-nav">
      <ul class="flex items-center gap-6">
        {
          data.nav.items.map((item, i) => (
            <li>
              <a href={anchor(item.id)} class="nav-link whitespace-nowrap font-mono text-xs font-medium uppercase tracking-[0.1em] text-muted hover:text-fg" data-nav={item.id} data-umami-event="nav-click" data-umami-event-section={item.id}>
                <span class="text-accent" aria-hidden="true">{pad(i + 1)} </span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2 xl:ml-6">
      <LangSwitch locale={locale} kind={kind} label={data.a11y.langSwitch} />
      <a
        href={data.nav.cta.href}
        class="btn btn-ghost !min-h-10 !px-3"
        data-umami-event="cta-linkedin"
        data-umami-event-location="header"
        target="_blank"
        rel="noopener noreferrer me"
      >
        <Icon name="linkedin" />
        <span class="hidden sm:inline">{data.nav.cta.label}</span>
        <span class="sr-only"> {data.a11y.externalLink}</span>
      </a>
      <button
        type="button"
        class="btn btn-ghost !min-h-10 !px-3 xl:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
        data-label-open={data.a11y.openMenu}
        data-label-close={data.a11y.closeMenu}
      >
        <Icon name="menu" class="menu-icon-open" />
        <Icon name="x" class="menu-icon-close hidden" />
        <span class="sr-only" data-menu-label>{data.a11y.openMenu}</span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label={data.a11y.mainNav} class="hidden border-t border-line bg-bg xl:!hidden" data-mobile-nav>
    <ul class="mx-auto grid max-w-7xl gap-1 px-4 py-4 sm:px-6">
      {
        data.nav.items.map((item, i) => (
          <li>
            <a href={anchor(item.id)} class="flex min-h-12 items-center gap-3 rounded-md px-2 font-mono text-sm uppercase tracking-[0.1em] text-fg hover:bg-accent-soft" data-umami-event="nav-click" data-umami-event-section={item.id} data-umami-event-menu="mobile">
              <span class="text-accent" aria-hidden="true">{pad(i + 1)}</span>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
